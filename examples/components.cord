bot "ComponentDemo"

config:
    prefix = "!"

command menu:
    reply "Choose your role and actions below:" with:
        button "verify_btn":
            label "Verify Account"
            style "success"
            emoji "✅"
        button "docs_btn":
            label "Read Docs"
            style "link"
            url "https://cord-lang.org"
        select "role_select":
            placeholder "Select your specialization..."
            min_values 1
            max_values 1
            option "engineer":
                label "Software Engineer"
                description "Builds systems and bot commands"
                emoji "💻"
            option "designer":
                label "UI/UX Designer"
                description "Designs stunning interfaces"
                emoji "🎨"
            option "community":
                label "Community Manager"
                description "Nurtures the server community"
                emoji "🌟"

when button "verify_btn" is clicked:
    reply "Verification complete! Welcome to the server, {author.name}."

when select "role_select" is chosen:
    reply "Updated role preference to **{selected}** for {author.name}!"
